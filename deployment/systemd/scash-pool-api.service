[Unit]
Description=Scash pool: public API (127.0.0.1:8122)
After=scash-pool-redis.service scash-node.service
Requires=scash-pool-redis.service
[Service]
Type=simple
User=scashpool
WorkingDirectory=/opt/scash-nodejs-pool
ExecStart=/usr/bin/node /opt/scash-nodejs-pool/init.js -module=api
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
