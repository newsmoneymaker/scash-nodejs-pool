[Unit]
Description=Scash pool: block unlocker (credits the miners after the coinbase maturity)
After=scash-pool-redis.service scash-node.service
Requires=scash-pool-redis.service
[Service]
Type=simple
User=scashpool
WorkingDirectory=/opt/scash-nodejs-pool
ExecStart=/usr/bin/node /opt/scash-nodejs-pool/init.js -module=unlocker
Restart=always
RestartSec=15
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
