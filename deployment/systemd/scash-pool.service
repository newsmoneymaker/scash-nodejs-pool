[Unit]
Description=Scash pool: stratum server (miners, share checking with the rxhash helper, block submission)
After=scash-pool-redis.service scash-node.service
Requires=scash-pool-redis.service
[Service]
Type=simple
User=scashpool
WorkingDirectory=/opt/scash-nodejs-pool
ExecStart=/usr/bin/node /opt/scash-nodejs-pool/init.js -module=pool
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
# ports below 1024 need this:
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
